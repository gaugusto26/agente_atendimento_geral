    {"parameters": {"jsCode": "const source = $(\"Extrair campos Chatwoot\").first().json;\nconst tenant = $json;\n\nconst traceId = \"xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx\".replace(/[xy]/g, function (c) {\n  const r = Math.random() * 16 | 0;\n  const v = c === \"x\" ? r : (r & 0x3 | 0x8);\n  return v.toString(16);\n});\n\nconst universalMessage = {\n  tenant_id: tenant.tenant_id,\n  source: {\n    provider: source.provider,\n    channel: source.channel,\n    account_id: source.account_id,\n    inbox_id: source.inbox_id\n  },\n  contact: {\n    external_id: source.contact_external_id,\n    name: source.contact_name,\n    phone: source.contact_phone\n  },\n  conversation: {\n    external_id: source.conversation_external_id\n  },\n  message: {\n    id: source.message_external_id,\n    direction: source.direction,\n    type: source.message_type,\n    text: tenant.transcribed_text || source.message_text,\n    timestamp: source.message_timestamp\n  },\n  trace_id: traceId\n};\n\nconst requiredFields = [\n  [\"tenant_id\", universalMessage.tenant_id],\n  [\"source.provider\", universalMessage.source.provider],\n  [\"source.channel\", universalMessage.source.channel],\n  [\"contact.external_id\", universalMessage.contact.external_id],\n  [\"conversation.external_id\", universalMessage.conversation.external_id],\n  [\"message.id\", universalMessage.message.id],\n  [\"message.direction\", universalMessage.message.direction],\n  [\"message.type\", universalMessage.message.type],\n  [\"message.timestamp\", universalMessage.message.timestamp]\n];\n\nfor (const [fieldName, fieldValue] of requiredFields) {\n  if (fieldValue === undefined || fieldValue === null || fieldValue === \"\") {\n    throw new Error(\"Universal Message invalido: campo obrigatorio ausente - \" + fieldName);\n  }\n}\n\nreturn [{ json: universalMessage }];"}, "id": "12132909-8b8a-411d-9700-9892fc940e49", "name": "Montar Universal Message", "type": "n8n-nodes-base.code", "position": [2032, 192], "typeVersion": 2},
