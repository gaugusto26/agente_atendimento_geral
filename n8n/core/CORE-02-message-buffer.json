    {"id": "55a0d693-2b75-4f39-9f18-1f9b5d6cd43f", "name": "IA ativa?", "type": "n8n-nodes-base.if", "typeVersion": 2.3, "position": [1740, 200], "parameters": {"conditions": {"options": {"caseSensitive": true, "leftValue": "", "typeValidation": "loose"}, "conditions": [{"leftValue": "={{ $json.status }}", "operator": {"type": "string", "operation": "equals"}, "rightValue": "AI_ACTIVE"}], "combinator": "and"}}},
    {"id": "82cdad0d-9004-4a05-9e40-b7cc7a159d92", "name": "Buscar mensagens pendentes", "type": "n8n-nodes-base.postgres", "typeVersion": 2.7, "position": [2040, 100], "parameters": {"operation": "executeQuery", "query": "SELECT m.text, m.type FROM message_buffer mb JOIN messages m ON m.id = mb.message_id WHERE mb.tenant_id = $1 AND mb.conversation_id = $2 AND mb.consumed_at IS NULL ORDER BY mb.created_at ASC;", "options": {"queryReplacement": "={{ $(\"Buffer Trigger\").item.json.tenant_id }},{{ $(\"Buffer Trigger\").item.json.conversation_id }}"}}, "credentials": {"postgres": {"id": "HWj1IxdP3nT29lom", "name": "agent_platform_postgres"}}},
    {"id": "a7f95097-3bbc-4f60-adf1-257401d2da9e", "name": "Agregar mensagens", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [2340, 100], "parameters": {"mode": "runOnceForAllItems", "language": "javaScript", "jsCode": "const items = $input.all();\nconst placeholders = {\n  audio: '[O cliente enviou uma mensagem de audio - sem transcricao disponivel]',\n  image: '[O cliente enviou uma imagem]',\n  video: '[O cliente enviou um video]',\n  file: '[O cliente enviou um arquivo]'\n};\nconst texts = [];\nlet hasAudio = false;\nfor (const item of items) {\n  const text = item.json.text;\n  if (item.json.type === 'audio') hasAudio = true;\n  if (text) {\n    texts.push(text);\n  } else {\n    texts.push(placeholders[item.json.type] || '[O cliente enviou uma mensagem sem texto]');\n  }\n}\nreturn [{ json: { aggregated_text: texts.join(\"\\n\"), message_count: texts.length, input_type: hasAudio ? 'audio' : 'text' } }];"}},
    {"id": "e0f811ec-ab06-4967-8cdf-8eb8e52a7749", "name": "Marcar buffer consumido", "type": "n8n-nodes-base.postgres", "typeVersion": 2.7, "position": [2640, 100], "parameters": {"operation": "executeQuery", "query": "UPDATE message_buffer SET consumed_at = now() WHERE tenant_id = $1 AND conversation_id = $2 AND consumed_at IS NULL;", "options": {"queryReplacement": "={{ $(\"Buffer Trigger\").item.json.tenant_id }},{{ $(\"Buffer Trigger\").item.json.conversation_id }}"}}, "credentials": {"postgres": {"id": "HWj1IxdP3nT29lom", "name": "agent_platform_postgres"}}},
