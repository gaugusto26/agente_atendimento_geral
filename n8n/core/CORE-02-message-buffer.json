    {"id": "11fde145-e590-41fa-a559-6f74cd013b44", "name": "Buscar mensagem mais recente do buffer", "type": "n8n-nodes-base.postgres", "typeVersion": 2.7, "position": [840, 300], "parameters": {"operation": "executeQuery", "query": "SELECT message_id FROM message_buffer WHERE tenant_id = $1 AND conversation_id = $2 AND consumed_at IS NULL ORDER BY created_at DESC LIMIT 1;", "options": {"queryReplacement": "={{ $(\"Buffer Trigger\").item.json.tenant_id }},{{ $(\"Buffer Trigger\").item.json.conversation_id }}"}}, "credentials": {"postgres": {"id": "HWj1IxdP3nT29lom", "name": "agent_platform_postgres"}}},
    {"id": "b9bf6e3a-a9b6-4c8c-a836-fb101f8452c1", "name": "Ainda e a mais recente?", "type": "n8n-nodes-base.if", "typeVersion": 2.3, "position": [1140, 300], "parameters": {"conditions": {"options": {"caseSensitive": true, "leftValue": "", "typeValidation": "loose"}, "conditions": [{"leftValue": "={{ $json.message_id }}", "operator": {"type": "string", "operation": "equals"}, "rightValue": "={{ $(\"Buffer Trigger\").item.json.message_id }}"}], "combinator": "and"}}},
