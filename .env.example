# Nenhum valor real deve ser commitado neste arquivo.
# Copie para .env e preencha localmente / configure via secret manager.

# --- Banco de dados ---
DATABASE_URL=postgres://user:password@host:5432/agent_platform

# --- n8n ---
N8N_BASE_URL=
N8N_WEBHOOK_BASE_URL=
N8N_API_KEY=

# --- CRMs (por tenant, ver config/tenant.example.json para o restante) ---
KOMMO_CLIENT_ID=
KOMMO_CLIENT_SECRET=
CHATWOOT_BASE_URL=
CHATWOOT_API_ACCESS_TOKEN=
DATACRY_BASE_URL=
DATACRY_API_KEY=

# --- LLM providers ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- Calendar / Files ---
GOOGLE_CALENDAR_CREDENTIALS_JSON=
GOOGLE_DRIVE_CREDENTIALS_JSON=

# --- Voz (opcional) ---
ELEVENLABS_API_KEY=
